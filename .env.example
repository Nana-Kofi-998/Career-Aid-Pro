# Career-Aid Pro Environment Configuration
# Copy this file to .env and update the values

# Environment: use production in deployed environments.
CAREER_AID_ENV=development

# JWT Secret - CRITICAL: set a unique value before production deploy.
# Generate a strong random key: python -c "import secrets; print(secrets.token_urlsafe(64))"
CAREER_AID_JWT_SECRET=

# Ollama Configuration
# AI_SERVICE_URL is the value used by the backend. OLLAMA_HOST is also supported.
AI_SERVICE_URL=http://127.0.0.1:11434
OLLAMA_HOST=http://localhost:11434

# Database
CAREER_AID_DB=career_aid_pro.db

# CORS Origins (comma-separated)
CAREER_AID_CORS=http://localhost:5173,http://127.0.0.1:5173

# Token expiration (hours)
CAREER_AID_TOKEN_HOURS=72

# Model Configuration
CAREER_AID_MODEL_CAREER=mistral
CAREER_AID_MODEL_MENTAL=llama3.1
CAREER_AID_MODEL_OPEN=llama3.2
CAREER_AID_MODEL_VISION=llava
